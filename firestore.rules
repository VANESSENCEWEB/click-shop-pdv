rules_version = '2';

// Regras do Click Shop PDV (demonstração pública, sem Firebase Auth).
// Quem visita pode ler o catálogo, cadastrar o catálogo de exemplo e vender.
// Ninguém consegue apagar nada, alterar preço ou aumentar estoque pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    function validProduct(data) {
      return data.keys().hasOnly(['name', 'price', 'stock', 'code', 'category', 'image'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.price is number && data.price > 0 && data.price < 100000
        && data.stock is int && data.stock >= 0 && data.stock <= 10000;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if validProduct(request.resource.data);
      // Venda: só o campo stock muda, e só para baixo (nunca negativo).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
      allow delete: if false;
    }

    match /sales/{saleId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['items', 'total', 'paymentMethod', 'amountReceived', 'change', 'operator', 'createdAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.paymentMethod in ['dinheiro', 'cartao', 'pix']
        && request.resource.data.operator is string && request.resource.data.operator.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
